\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {EXP-R1c: the pre-registered collapse, on every target.} \textbf  {Claim} (§\ref {sec:identification}): $\mathrm  {do}(E)$ moves deception $D$ and compliance behavior $C$ together, so instructed accuracy cannot be attributed to $D$. \textbf  {Prediction}: removing the instruction asymmetry, claim truth-value still varying, removes any signal attributable to $E$ or $C$. \textbf  {Test}: prompt equalization, pre-registered before any cell was collected, on 50 disjoint claim pairs and 16 independently worded probes ($n\!=\!50$/cell; instructed every $p\!=\!0.001$, equalized every $p\!\geq \!0.173$; every cell in Table~\ref {tab:r1c_v2}). \textbf  {Equalization is a confound test, not a deception test:} it asks whether the benchmark's accuracy depends on elicitation asymmetry, not whether deception exists---it may remove the deception with the confound, so criterion~4 (§\ref {sec:eval_controls}), not this collapse, is what would test attribution. Dashed line is chance; equalized points below it mark a \textbf  {degenerate} probe channel (0--2 of 16 dimensions varying)---absence of a usable signal, not inverted discrimination.}}{6}{figure.caption.14}\protected@file@percent }
\newlabel{fig:r1c_collapse}{{2}{6}{\textbf {EXP-R1c: the pre-registered collapse, on every target.} \textbf {Claim} (§\ref {sec:identification}): $\mathrm {do}(E)$ moves deception $D$ and compliance behavior $C$ together, so instructed accuracy cannot be attributed to $D$. \textbf {Prediction}: removing the instruction asymmetry, claim truth-value still varying, removes any signal attributable to $E$ or $C$. \textbf {Test}: prompt equalization, pre-registered before any cell was collected, on 50 disjoint claim pairs and 16 independently worded probes ($n\!=\!50$/cell; instructed every $p\!=\!0.001$, equalized every $p\!\geq \!0.173$; every cell in Table~\ref {tab:r1c_v2}). \textbf {Equalization is a confound test, not a deception test:} it asks whether the benchmark's accuracy depends on elicitation asymmetry, not whether deception exists---it may remove the deception with the confound, so criterion~4 (§\ref {sec:eval_controls}), not this collapse, is what would test attribution. Dashed line is chance; equalized points below it mark a \textbf {degenerate} probe channel (0--2 of 16 dimensions varying)---absence of a usable signal, not inverted discrimination}{figure.caption.14}{}}
