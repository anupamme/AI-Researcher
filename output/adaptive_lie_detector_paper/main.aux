\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces \textbf  {Prior work and the audited corpora against the five requirements} of §1's box (§\ref {sec:eval_controls}): \textbf  {(i)}~$E$ fixed, \textbf  {(ii)}~$D$ graded independently of the condition label, \textbf  {(iii)}~the same scenario independently realized under both behavioral outcomes, \textbf  {(iv)}~deployed-observable channel only, \textbf  {(v)}~$D$ not definitionally equivalent to the detector's input. \text  {$\mathsurround \z@ \mathchar "458$}~= satisfied, $\times $~= not, \emph  {p}~= satisfied in some settings or for some detector families, \text  {$\mathsurround \z@ \mathchar "458$}$^{*}$~= exceeded, with $D$ \emph  {set} rather than observed, \emph  {n/a}~= the requirement concerns a detector's input and the evaluation reports no per-response detector score. The last column asks the question this paper is about. \textbf  {Rows are grouped by what kind of thing each entry is}---(a)~instructed-lie benchmarks, (b)~generalization studies, (c)~belief-verified model organisms, (d)~public rollout corpora, (e)~adjacent constructs---because they answer different questions, and only (a) is what our identification claim is \emph  {about}. \textbf  {Reading the table:} fixed elicitation is not new---\citet  {cooney2026didyoulie}'s trained organisms have it, and go beyond it (Table~\ref {tab:criteria}'s last row)---but no entry combines it with a deployed-observable channel, an independently grounded $D$, and a test of whether \emph  {instructed}-benchmark accuracy was attributable to deception; among the deception designs the sandbagging row is the near-miss, failing only~(iii). That combination is what criterion~4 asks for and what §\ref {sec:external_audit} audits. \textbf  {Group~(e)} reads $D$ as the behavior each evaluation attributes its score to; it shows the requirements are decidable outside deception given a specification, \emph  {not} that the confound is active there. \textbf  {EXP-AF (Appendix~\ref {app:eccp_decidability}) carries that from the design level to the corpus level and finds the same thing}: over 28 pinned public corpora, each of the three properties that would make a benchmark auditable holds somewhere---2, 21 and 3 corpora---\emph  {none} holds all three, and \textbf  {no magnitude is measured outside deception}. \textbf  {This work} states~(i)--(v), audits \emph  {both} public releases against them---ten rollout sets and 35 cells---and builds materials meeting all five (EXP-C4).}}{21}{table.caption.50}\protected@file@percent }
\newlabel{tab:prior_work_criteria}{{7}{21}{\textbf {Prior work and the audited corpora against the five requirements} of §1's box (§\ref {sec:eval_controls}): \textbf {(i)}~$E$ fixed, \textbf {(ii)}~$D$ graded independently of the condition label, \textbf {(iii)}~the same scenario independently realized under both behavioral outcomes, \textbf {(iv)}~deployed-observable channel only, \textbf {(v)}~$D$ not definitionally equivalent to the detector's input. \checkmark ~= satisfied, $\times $~= not, \emph {p}~= satisfied in some settings or for some detector families, \checkmark $^{*}$~= exceeded, with $D$ \emph {set} rather than observed, \emph {n/a}~= the requirement concerns a detector's input and the evaluation reports no per-response detector score. The last column asks the question this paper is about. \textbf {Rows are grouped by what kind of thing each entry is}---(a)~instructed-lie benchmarks, (b)~generalization studies, (c)~belief-verified model organisms, (d)~public rollout corpora, (e)~adjacent constructs---because they answer different questions, and only (a) is what our identification claim is \emph {about}. \textbf {Reading the table:} fixed elicitation is not new---\citet {cooney2026didyoulie}'s trained organisms have it, and go beyond it (Table~\ref {tab:criteria}'s last row)---but no entry combines it with a deployed-observable channel, an independently grounded $D$, and a test of whether \emph {instructed}-benchmark accuracy was attributable to deception; among the deception designs the sandbagging row is the near-miss, failing only~(iii). That combination is what criterion~4 asks for and what §\ref {sec:external_audit} audits. \textbf {Group~(e)} reads $D$ as the behavior each evaluation attributes its score to; it shows the requirements are decidable outside deception given a specification, \emph {not} that the confound is active there. \textbf {EXP-AF (Appendix~\ref {app:eccp_decidability}) carries that from the design level to the corpus level and finds the same thing}: over 28 pinned public corpora, each of the three properties that would make a benchmark auditable holds somewhere---2, 21 and 3 corpora---\emph {none} holds all three, and \textbf {no magnitude is measured outside deception}. \textbf {This work} states~(i)--(v), audits \emph {both} public releases against them---ten rollout sets and 35 cells---and builds materials meeting all five (EXP-C4)}{table.caption.50}{}}
