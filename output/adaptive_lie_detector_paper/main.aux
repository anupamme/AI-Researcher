\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Criterion 4 on ten rollout sets from one public release}~\citep  {goldowskydill2025probes}, scored offline---seven scenario designs, every rollout Llama-70B, so \textbf  {not ten independent benchmark efforts}; criterion~4 asks about a \emph  {design}, so this surveys what public material can express. Pre-specified gates: $E$ is fixed only if all rollouts share one byte-identical system prompt, and a rule must fire on 5--95\% of some cell of $\geq $10 rollouts (Appendices~\ref {app:external_audit},~\ref {app:insider_audit}).}}{8}{table.caption.20}\protected@file@percent }
\newlabel{tab:external_audit}{{3}{8}{\textbf {Criterion 4 on ten rollout sets from one public release}~\citep {goldowskydill2025probes}, scored offline---seven scenario designs, every rollout Llama-70B, so \textbf {not ten independent benchmark efforts}; criterion~4 asks about a \emph {design}, so this surveys what public material can express. Pre-specified gates: $E$ is fixed only if all rollouts share one byte-identical system prompt, and a rule must fire on 5--95\% of some cell of $\geq $10 rollouts (Appendices~\ref {app:external_audit},~\ref {app:insider_audit})}{table.caption.20}{}}
