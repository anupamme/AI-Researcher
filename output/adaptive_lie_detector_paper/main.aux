\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \relax \fontsize  {9}{10pt}\selectfont  \textbf  {The evidence roadmap: three levels of claim, three kinds of warrant.} \textbf  {A} holds by structure; \textbf  {B} is \textbf  {one empirical demonstration} that the canonical benchmark instantiates it; \textbf  {C} is \textbf  {a survey} of what public corpora supply, where attribution---which criterion~4 alone tests---is instrument-specific. \textbf  {Bold rows are load-bearing}; the factorial is a \emph  {diagnostic}, and sizes what is unattributable rather than attributing it. \textbf  {$E$?}~= elicitation held byte-identical; \textbf  {$D$?}~= $D$ graded independently of the condition label ($\dagger $~but \emph  {observationally}, so not $\tau _D$). \textsuperscript  {\textsc  {pr}}~= \textbf  {pre-registered before the data were seen} (also EXP-WP, §\ref {sec:td_vs_fd}); \textbf  {unmarked = exploratory}, including the lexical rule and the factorial.}}{3}{table.caption.3}\protected@file@percent }
\newlabel{tab:roadmap}{{1}{3}{\small \textbf {The evidence roadmap: three levels of claim, three kinds of warrant.} \textbf {A} holds by structure; \textbf {B} is \textbf {one empirical demonstration} that the canonical benchmark instantiates it; \textbf {C} is \textbf {a survey} of what public corpora supply, where attribution---which criterion~4 alone tests---is instrument-specific. \textbf {Bold rows are load-bearing}; the factorial is a \emph {diagnostic}, and sizes what is unattributable rather than attributing it. \textbf {$E$?}~= elicitation held byte-identical; \textbf {$D$?}~= $D$ graded independently of the condition label ($\dagger $~but \emph {observationally}, so not $\tau _D$). \textsuperscript {\textsc {pr}}~= \textbf {pre-registered before the data were seen} (also EXP-WP, §\ref {sec:td_vs_fd}); \textbf {unmarked = exploratory}, including the lexical rule and the factorial}{table.caption.3}{}}
