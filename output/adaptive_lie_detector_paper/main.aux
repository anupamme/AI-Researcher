\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \relax \fontsize  {9}{10pt}\selectfont  \textbf  {The audit protocol as an evidence ladder, and where this paper stops.} Each control rules out one alternative explanation for a detector's accuracy; only rung~5 licenses a causal claim. \textbf  {This paper reaches rung~4}: EXP-C4 exhibits a deception-\emph  {associated} signal at byte-identical elicitation---necessary for, but not equal to, $\tau _D$, which needs $D$ manipulated or randomised.}}{5}{figure.caption.10}\protected@file@percent }
