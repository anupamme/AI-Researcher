\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces \textbf  {The pre-registered frontier-scale panel} (EXP-FS): 7 targets from 7 organizations, $n\!=\!100$ each, one byte-identical neutral system prompt in both conditions and no target ever instructed to lie. \textbf  {Rule} is the parameter-free 14-pattern rule (RC$\,\geq \,1$), with \emph  {nothing} fit; \textbf  {Pipeline} is the detector trained on $\leq $70B open-weight targets, transferred unchanged. At $n\!=\!100$ the smallest count significantly above chance is 61/100. Rows marked $\dagger $ were already published and are re-scored here by the PREREG~§8.3 gate, not newly collected; Holm correction runs within the 5 new targets, within each outcome family separately.}}{23}{table.caption.54}\protected@file@percent }
\newlabel{tab:frontier_panel}{{9}{23}{\textbf {The pre-registered frontier-scale panel} (EXP-FS): 7 targets from 7 organizations, $n\!=\!100$ each, one byte-identical neutral system prompt in both conditions and no target ever instructed to lie. \textbf {Rule} is the parameter-free 14-pattern rule (RC$\,\geq \,1$), with \emph {nothing} fit; \textbf {Pipeline} is the detector trained on $\leq $70B open-weight targets, transferred unchanged. At $n\!=\!100$ the smallest count significantly above chance is 61/100. Rows marked $\dagger $ were already published and are re-scored here by the PREREG~§8.3 gate, not newly collected; Holm correction runs within the 5 new targets, within each outcome family separately}{table.caption.54}{}}
