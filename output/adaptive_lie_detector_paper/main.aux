\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \relax \fontsize  {9}{10pt}\selectfont  \textbf  {The pre-registered equalization collapse, on every target} (EXP-R1c). \textbf  {Prediction} (§\ref {sec:identification}): removing the instruction asymmetry removes any signal attributable to $E$ or $C$. \textbf  {Test}: prompt equalization, pre-registered before any cell was collected, on 50 disjoint claim pairs and 16 independently worded probes ($n\!=\!50$/cell; instructed every $p\!=\!0.001$; Appendix Table~\ref {tab:r1c_v2}). Points below the dashed chance line mark a \textbf  {degenerate} probe channel (0--2 of 16 dimensions varying)---absence of a usable signal, not inverted discrimination (3B's 24.0\% is stratified 5-fold; claim-pair-grouped folds give 36.0\%).}}{7}{figure.caption.13}\protected@file@percent }
\newlabel{fig:r1c_collapse}{{3}{7}{\small \textbf {The pre-registered equalization collapse, on every target} (EXP-R1c). \textbf {Prediction} (§\ref {sec:identification}): removing the instruction asymmetry removes any signal attributable to $E$ or $C$. \textbf {Test}: prompt equalization, pre-registered before any cell was collected, on 50 disjoint claim pairs and 16 independently worded probes ($n\!=\!50$/cell; instructed every $p\!=\!0.001$; Appendix Table~\ref {tab:r1c_v2}). Points below the dashed chance line mark a \textbf {degenerate} probe channel (0--2 of 16 dimensions varying)---absence of a usable signal, not inverted discrimination (3B's 24.0\% is stratified 5-fold; claim-pair-grouped folds give 36.0\%)}{figure.caption.13}{}}
