\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {The audit protocol as an evidence ladder}: what each control establishes, ending at a rung no design audited here reaches. \textbf  {Criterion~4 is necessary}---it removes the elicitation confound---but what it establishes is a deception-\emph  {associated} signal, not $\tau _D$. It is also \textbf  {the one criterion an auditor cannot add after publication}: an instruction-only design can be \emph  {failed} by it but never \emph  {passed} (Appendix~\ref {app:criteria_taxonomy}).}}{5}{table.caption.9}\protected@file@percent }
