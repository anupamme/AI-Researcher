\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces \textbf  {Prior work and the audited corpora against the five requirements} of §1's box (§\ref {sec:eval_controls}): \textbf  {(i)}~$E$ fixed, \textbf  {(ii)}~$D$ graded independently of the condition label, \textbf  {(iii)}~same item under both conditions, \textbf  {(iv)}~deployed-observable channel only, \textbf  {(v)}~$D$ not definitionally equivalent to the detector's input. \text  {$\mathsurround \z@ \mathchar "458$}~= satisfied, $\times $~= not, \emph  {p}~= satisfied in some settings or for some detector families, \text  {$\mathsurround \z@ \mathchar "458$}$^{*}$~= exceeded, with $D$ \emph  {set} rather than observed. The last column asks the question this paper is about. \textbf  {Reading the table:} fixed elicitation is not new---\citet  {cooney2026didyoulie}'s trained organisms have it, and go beyond it (Table~\ref {tab:criteria}'s last row)---but no entry combines it with a deployed-observable channel, an independently grounded $D$, and a test of whether \emph  {instructed}-benchmark accuracy was attributable to deception; the sandbagging row is the near-miss, failing only~(iii). That combination is what criterion~4 asks for and what §\ref {sec:external_audit} audits.}}{16}{table.caption.40}\protected@file@percent }
\newlabel{tab:prior_work_criteria}{{6}{16}{\textbf {Prior work and the audited corpora against the five requirements} of §1's box (§\ref {sec:eval_controls}): \textbf {(i)}~$E$ fixed, \textbf {(ii)}~$D$ graded independently of the condition label, \textbf {(iii)}~same item under both conditions, \textbf {(iv)}~deployed-observable channel only, \textbf {(v)}~$D$ not definitionally equivalent to the detector's input. \checkmark ~= satisfied, $\times $~= not, \emph {p}~= satisfied in some settings or for some detector families, \checkmark $^{*}$~= exceeded, with $D$ \emph {set} rather than observed. The last column asks the question this paper is about. \textbf {Reading the table:} fixed elicitation is not new---\citet {cooney2026didyoulie}'s trained organisms have it, and go beyond it (Table~\ref {tab:criteria}'s last row)---but no entry combines it with a deployed-observable channel, an independently grounded $D$, and a test of whether \emph {instructed}-benchmark accuracy was attributable to deception; the sandbagging row is the near-miss, failing only~(iii). That combination is what criterion~4 asks for and what §\ref {sec:external_audit} audits}{table.caption.40}{}}
